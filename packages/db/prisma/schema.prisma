generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id // Logto's `sub` (user ID)
  email     String?
  name      String?
  username  String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
